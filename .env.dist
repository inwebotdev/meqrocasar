# OpenRouter (https://openrouter.ai/keys). Required for real AI generation; without it a local fallback is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_MS=8000
# Unsplash (https://unsplash.com/developers). Optional: when empty, bundled fallback photos are used.
UNSPLASH_ACCESS_KEY=
# Public URL of the app (used for the OpenRouter HTTP-Referer header and absolute asset URLs)
APP_URL=http://localhost:3000
# Host port published by docker-compose
APP_PORT=3000
