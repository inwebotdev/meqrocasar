# OpenRouter (https://openrouter.ai/keys). Required for real AI generation; without it a local fallback is used.
OPENROUTER_API_KEY=
# Final experience generation (POST /api/generate-experience), from the full quiz
# transcript + knowledge-base digest. Defaults come from `docs/ai-step-benchmark.md`
# (`kool run ai:bench`): qwen-2.5-72b-instruct and deepseek-chat (the previous
# defaults here) measured 0% and 22% schema-valid against this app's real OpenRouter
# traffic, with ~40s p50s, so they time out far more often than they succeed.
# qwen3-30b-a3b/qwen-2.5-7b-instruct were the two reliable candidates in that run.
OPENROUTER_MODEL_PRIMARY=qwen/qwen3-30b-a3b
OPENROUTER_MODEL_FALLBACK=qwen/qwen-2.5-7b-instruct
OPENROUTER_TIMEOUT_MS=8000
# Fast model used by the adaptive quiz engine (POST /api/quiz/next) to generate
# each next question/options from the transcript + knowledge base; kept separate
# from the (slower) primary/fallback pair above, which is only used for the
# final experience generation. Both defaults come from `docs/ai-step-benchmark.md`
# (`kool run ai:bench`): qwen-2.5-7b-instruct was 100% schema-valid-on-first-try
# and 100% Spanish-only on every benchmark run, at the lowest cost of any working
# candidate; qwen3-30b-a3b is the next most reliable, replacing deepseek-chat
# (measured only 22-33% valid and ~40s p50 against this layer's step schema).
OPENROUTER_MODEL_FAST=qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL_FAST_FALLBACK=qwen/qwen3-30b-a3b
# Max adaptive quiz steps (including the curated step 1) before the engine
# stops and the final experience is generated from the transcript so far.
QUIZ_MAX_STEPS=7
QUIZ_STEP_TIMEOUT_MS=6000
# Speculative prefetch: while a step is shown, POST /api/quiz/prefetch warms
# the engine's cache for every visible option, so the option the couple
# actually picks resolves near-instantly. Set to false to disable.
QUIZ_PREFETCH=true
# Unsplash (https://unsplash.com/developers). Optional: when empty, bundled fallback photos are used.
UNSPLASH_ACCESS_KEY=
# Google Places API (New) (https://console.cloud.google.com/apis/library/places.googleapis.com).
# Required (with billing enabled) for `kool run kb:ingest` and for /api/places/photo; without it
# the app runs on the curated/already-ingested knowledge base and that route is disabled.
GOOGLE_PLACES_API_KEY=
# Disk cache for proxied Places photos (30-day TTL), relative to the repo root.
PLACES_PHOTO_CACHE_DIR=.cache/places
# ElevenLabs (https://elevenlabs.io/app/voice-library): pick a Mexican-Spanish
# female voice in the Voice Library and copy its Voice ID below. Both optional:
# without a key or a voice id, the reel's narration stays disabled (the reel
# plays silently) and nothing in this layer calls ElevenLabs for real.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Disk cache for narration mp3s + their sentence-timing sidecar JSON, relative to the repo root.
NARRATION_CACHE_DIR=.cache/narration
# Dev-only: set to 1 to browser-check the narrated reel (captions, ducked music,
# the "Narración · Querétaro Romance" pill) without an ELEVENLABS_API_KEY, via a
# local fixture (test/fixtures/narration/sample.json). Never set this in production.
NEXT_PUBLIC_NARRATION_FIXTURE=
# Public URL of the app (used for the OpenRouter HTTP-Referer header and absolute asset URLs)
APP_URL=http://localhost:3000
# Host port published by docker-compose
APP_PORT=3000

# Narration provider: auto (Google when a Google key exists, else ElevenLabs), google, elevenlabs, none
NARRATION_PROVIDER=auto
# Google Cloud Text-to-Speech (enable "Cloud Text-to-Speech API" on the project). Falls back to GOOGLE_PLACES_API_KEY when empty.
GOOGLE_TTS_API_KEY=
# Mexican Spanish female voices: es-MX-Neural2-A, es-MX-Wavenet-A, es-MX-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE=es-MX-Neural2-A
