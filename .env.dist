# OpenRouter (https://openrouter.ai/keys). Required for real AI generation; without it a local fallback is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_MS=8000
# Fast model used by the adaptive quiz engine (POST /api/quiz/next) to generate
# each next question/options from the transcript + knowledge base; kept separate
# from the (slower) primary/fallback pair above, which is only used for the
# final experience generation. qwen-2.5-7b-instruct consistently answered this
# layer's step schema in well under 2s in real testing; deepseek-chat (used as
# the primary/fallback pair's fallback above) is kept as the secondary attempt
# here too, but took 15-40s against this schema in testing, so it is only ever
# a last resort before the curated static fallback.
OPENROUTER_MODEL_FAST=qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL_FAST_FALLBACK=deepseek/deepseek-chat
# Max adaptive quiz steps (including the curated step 1) before the engine
# stops and the final experience is generated from the transcript so far.
QUIZ_MAX_STEPS=7
QUIZ_STEP_TIMEOUT_MS=6000
# Unsplash (https://unsplash.com/developers). Optional: when empty, bundled fallback photos are used.
UNSPLASH_ACCESS_KEY=
# Google Places API (New) (https://console.cloud.google.com/apis/library/places.googleapis.com).
# Required (with billing enabled) for `kool run kb:ingest` and for /api/places/photo; without it
# the app runs on the curated/already-ingested knowledge base and that route is disabled.
GOOGLE_PLACES_API_KEY=
# Disk cache for proxied Places photos (30-day TTL), relative to the repo root.
PLACES_PHOTO_CACHE_DIR=.cache/places
# Public URL of the app (used for the OpenRouter HTTP-Referer header and absolute asset URLs)
APP_URL=http://localhost:3000
# Host port published by docker-compose
APP_PORT=3000
